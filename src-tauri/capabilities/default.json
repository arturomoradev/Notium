{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Notium main window — least-privilege IPC only",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-vault-init",
    "allow-vault-open",
    "allow-vault-create-named",
    "allow-vault-rename-current",
    "allow-vault-delete-profile",
    "allow-vault-list-profiles",
    "allow-vault-export-bundle",
    "allow-vault-import-bundle",
    "allow-vault-get-settings",
    "allow-vault-update-settings",
    "allow-vault-rebuild-index",
    "allow-vault-pick-folder",
    "allow-vault-create-folder",
    "allow-vault-rename-folder",
    "allow-vault-delete-folder",
    "allow-vault-move-folder-to-vault",
    "allow-vault-list-folders",
    "allow-vault-import-attachment",
    "allow-vault-read-attachment",
    "allow-attachment-list",
    "allow-attachment-delete",
    "allow-attachment-delete-orphans",
    "allow-attachments-to-compress",
    "allow-attachment-mark-checked",
    "allow-attachment-replace",
    "allow-note-list",
    "allow-note-create",
    "allow-note-read",
    "allow-note-save",
    "allow-note-rename",
    "allow-note-move",
    "allow-note-delete",
    "allow-trash-list",
    "allow-trash-restore",
    "allow-trash-delete-item",
    "allow-trash-empty",
    "allow-note-search-fts",
    "allow-note-get-backlinks",
    "allow-note-get-outlinks",
    "allow-note-check-link-references",
    "allow-note-repair-links",
    "allow-note-unlinked-mentions",
    "allow-note-suggest-titles",
    "allow-get-sync-status",
    "allow-sync-now",
    "allow-configure-sync-server",
    "allow-pause-sync",
    "allow-resume-sync"
  ]
}
