{
  "name": "notium",
  "version": "0.1.2",
  "description": "Notium local-first Markdown note app",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "verify": "npm run check && npm run lint && npm run test:markdown && npm run build",
    "test:markdown": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test tools/markdown-formatting.test.mjs",
    "build:wasm": "cargo build -p notium-wasm --release --config profile.release.strip=false --target wasm32-unknown-unknown && wasm-bindgen --target web --out-dir src/web/wasm/pkg target/wasm32-unknown-unknown/release/notium_wasm.wasm",
    "dev:web": "npm run build:wasm && vite --config web/vite.config.ts",
    "build:web": "npm run build:wasm && vite build --config web/vite.config.ts",
    "check:web": "npm run build:wasm && svelte-check --tsconfig ./src/web/tsconfig.json",
    "test:web": "npm run build:wasm && node --disable-warning=ExperimentalWarning --experimental-strip-types --test tools/web-*.test.mjs",
    "test:server": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test tools/sync-server.test.mjs",
    "tauri": "tauri",
    "cloud:login": "cd server/cloudflare-sync && npx wrangler login",
    "cloud:setup": "cd server/cloudflare-sync && npx wrangler d1 create notium-db",
    "cloud:deploy": "cd server/cloudflare-sync && npx wrangler deploy",
    "cloud:deploy:web": "npm run build:web && cd server/cloudflare-sync && npx wrangler deploy --config ../notium-web/wrangler.jsonc"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource/cascadia-code": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@tauri-apps/api": "2.12.4",
    "mermaid": "^12.3.0",
    "svelte": "5.57.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.24.1",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.5"
  }
}
